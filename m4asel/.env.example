# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real keys. All EXPO_PUBLIC_* vars are bundled into the client, so only
# put values here that are safe to ship inside the app (the Supabase anon key
# is designed for this; the DB connection string / service role key are NOT —
# never put those in a mobile app).

EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://hdzyncyutatccpyndzkl.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Dev-only: when the backend profile fetch fails (e.g. backend doesn't verify
# Supabase tokens yet), fall back to a stub profile built from the Supabase
# user so the app is still navigable. Ignored in production builds regardless
# of this value. See docs/supabase-auth-migration.md.
EXPO_PUBLIC_USE_MOCK_PROFILE=true
